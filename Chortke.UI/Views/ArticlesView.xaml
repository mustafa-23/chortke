<UserControl x:Class="Chortke.UI.Views.ArticlesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Chortke.UI.Views"
             xmlns:vm="clr-namespace:Chortke.UI.ViewModels"
             xmlns:m="clr-namespace:Chortke.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type={x:Type vm:ArticlesViewModel}}"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>


        <x:Array x:Key="Articles" Type="{x:Type m:ArticleModel}">
            <m:ArticleModel Amount="10000000" Description="test article" IsDebit="True" CreateDate="1995/6/26"/>
            <m:ArticleModel Amount="10000000" Description="test article" IsDebit="True" CreateDate="1995/6/26"/>
        </x:Array>
    </UserControl.Resources>

    <Grid Visibility="{Binding Visibility}" Background="{StaticResource Brushes.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border DockPanel.Dock="Top" Background="{StaticResource Brushes.Secondary}" CornerRadius="8" Margin="8"
                BorderBrush="{StaticResource Brushes.Primary}" BorderThickness="1"
                Grid.Row="0">
            <Grid Margin="4">
                <StackPanel Orientation="Horizontal">
                    <Label Content="{DynamicResource Desc}"/>
                    <TextBox Width="250" FontSize="14" Text="{Binding Filter.Description,Mode=OneWayToSource}"/>
                    <Label Content="From Date" Margin="16,0,0,0"/>
                    <TextBox Width="150" FontSize="14" Text="{Binding Filter.FromDate,Mode=TwoWay,Converter={StaticResource DateTimeToPersian}}"/> 
                    <Label Content="To Date" Margin="16,0,0,0"/>
                    <TextBox Width="150" FontSize="14" Text="{Binding Filter.ToDate,Mode=TwoWay,Converter={StaticResource DateTimeToPersian}}"/>
                </StackPanel>
                <Button Content="Search" HorizontalAlignment="Right"
                        Width="75" Margin="0,0,8,0" Command="{Binding SearchCommand}"/>
            </Grid>
        </Border>
        <TextBlock DockPanel.Dock="Top" Margin="16,4" FontSize="14" Grid.Row="1">
            <TextBlock Text="{Binding Articles.Count}"/>
            Item(s) Found
        </TextBlock>
        <ScrollViewer Margin="8" Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Articles}" d:ItemsSource="{StaticResource Articles}"
                          ItemTemplate="{StaticResource Article.List}"
                          AlternationCount="2"/>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Margin="16,8">
            <Border Height="1" Background="{DynamicResource Brushes.Accent}"/>
            <UniformGrid Columns="2" Rows="1" Width="250" HorizontalAlignment="Right">
                <TextBlock Style="{StaticResource Text.Credit}" Text="{Binding TotalCredit,StringFormat=\{0:C0\}}"/>
                <TextBlock Style="{StaticResource Text.Debit}" Text="{Binding TotalDebit,StringFormat=\{0:C0\}}"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
