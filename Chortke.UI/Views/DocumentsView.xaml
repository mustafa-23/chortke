<UserControl x:Class="Chortke.UI.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Chortke.UI.ViewModels"
             xmlns:c="clr-namespace:Chortke.Common"
             xmlns:m="clr-namespace:Chortke.Models"
             xmlns:wpf="clr-namespace:Moonlight.WPF;assembly=Moonlight"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:DocumentsViewModel}">

    <UserControl.Resources>
        <CollectionViewSource x:Key="DocumentsSource" Source="{Binding Documents}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="CreateDate" Converter="{StaticResource DateToPratConverter}"/>
                <PropertyGroupDescription PropertyName="CreateDate" Converter="{StaticResource DateToPratConverter}"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid Margin="0,2,0,0" Visibility="{Binding Visibility}"
          Background="{StaticResource Brushes.Primary}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition />
            <ColumnDefinition Width="290"/>
        </Grid.ColumnDefinitions>

        <!--#region ActionBar -->
        <Border Background="{StaticResource Brushes.Secondary}">
            <StackPanel Margin="0,8,0,0">
                <Button Style="{StaticResource Button.Toolbar}" 
                        Content="{StaticResource ic_add-circle}"
                        ToolTip="{DynamicResource Add}" Padding="10"
                        Command="{x:Static c:GlobalCommands.AddDocument}"/>
                <Button Style="{StaticResource Button.Toolbar}" 
                        Content="{StaticResource ic_edit}"
                        ToolTip="{DynamicResource Edit}" Padding="10"
                        Command="{Binding SelectedDocument.EditCommand}"
                        IsEnabled="{Binding SelectedDocument,Converter={StaticResource Bool.FromNullable}}"/>
                <Button Style="{StaticResource Button.Toolbar}" 
                        Content="{StaticResource ic_trash}"
                        ToolTip="{DynamicResource Delete}" Padding="10"
                        wpf:CommonProps.HoverColor="Salmon"
                        Command="{Binding DeleteDocumentCommand}"/>
            </StackPanel>
        </Border>
        <!--#endregion-->

        <!--#region Settings -->
        <Border Background="{StaticResource Brushes.Secondary}" Margin="2,0,0,0"
                Grid.Column="1">
        </Border>
        <!--#endregion-->

        <StackPanel Grid.Column="2" Grid.Row="1" Margin="12,16,12,0">
            <TextBlock Text="{Binding SelectedDocument.CreateDate,Converter={StaticResource DateTimeToPersian},ConverterParameter='w y/M/d'}"
                       d:Text="دوشنبه 1374/04/05" FontSize="16" Foreground="{DynamicResource Brushes.Foreground}" HorizontalAlignment="Right"/>
            <Border Style="{StaticResource Border.HSep}"/>
            <ItemsControl ItemsSource="{Binding SelectedDocument.Articles}" AlternationCount="2"/>
            <Border Style="{StaticResource Border.HSep}"/>
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="125"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="مجموع" HorizontalAlignment="Left" FontSize="16"/>
                <TextBlock Text="{Binding SelectedDocument.Credit,StringFormat=\{0:C0\}}"
                           FontSize="18" Foreground="Green" Grid.Column="1"/>
                <TextBlock Text="{Binding SelectedDocument.Debit,StringFormat=\{0:C0\}}"
                               FontSize="18" Foreground="Red" HorizontalAlignment="Right"
                           Grid.Column="2"/>
            </Grid>
            <Border Style="{StaticResource Border.HSep}"/>
            <TextBlock Style="{StaticResource MainTitle}" Text="{StaticResource Desc}"
                       Margin="0,8,0,16"/>
            <TextBlock Text="{Binding SelectedDocument.Description}"
                       HorizontalAlignment="Left" FontSize="14" Margin="16,0,0,0"/>
        </StackPanel>

        <!--#region Props -->
        <Border Background="{StaticResource Brushes.Secondary}" Grid.Column="3">
            <Grid>
                <ListBox ItemsSource="{Binding DocumentsListViewSource}" Margin="-12,0"
                         SelectedItem="{Binding SelectedDocument,Mode=OneWayToSource}"
                         BorderThickness="0" Background="Transparent" FontSize="14">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Expander Header="{Binding }" Margin="16,0"
                                                          IsExpanded="{Binding Name,Converter={StaticResource IsExpandedConverter},Mode=OneWay}">
                                                    <ItemsPresenter/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Width="230"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <TextBlock Text="{DynamicResource Loading}" 
                           Visibility="{Binding IsLoading,Converter={StaticResource Visibility.FromBool}}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>

        </Border>
        <!--#endregion-->

        <TextBlock Text="{Binding ZIndex}" Foreground="Red" VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>
